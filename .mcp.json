{
  "name": "landlaw-ai-mcp",
  "description": "> **By [MEOK AI Labs](https://meok.ai)** \u2014 Sovereign AI tools for everyone.",
  "version": "1.0.0",
  "tools": [
    {
      "name": "search_land_registry",
      "description": "Search UK Land Registry by address, title number, or postcode.",
      "parameters": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "nullable": true
          },
          "title_number": {
            "type": "string",
            "nullable": true
          },
          "postcode": {
            "type": "string",
            "nullable": true
          }
        },
        "required": []
      }
    },
    {
      "name": "check_planning_permission",
      "description": "Check planning permission requirements for a property modification.",
      "parameters": {
        "type": "object",
        "properties": {
          "modification_type": {
            "type": "string"
          },
          "property_type": {
            "type": "string"
          },
          "listed_building": {
            "type": "boolean"
          },
          "conservation_area": {
            "type": "boolean"
          },
          "aonb": {
            "type": "boolean"
          }
        },
        "required": [
          "modification_type"
        ]
      }
    },
    {
      "name": "explain_covenant",
      "description": "Explain a restrictive or positive covenant in plain English.",
      "parameters": {
        "type": "object",
        "properties": {
          "covenant_text": {
            "type": "string"
          },
          "covenant_type": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "covenant_text"
        ]
      }
    },
    {
      "name": "calculate_sdlt",
      "description": "Calculate Stamp Duty Land Tax for a UK property purchase.",
      "parameters": {
        "type": "object",
        "properties": {
          "purchase_price": {
            "type": "number"
          },
          "first_time_buyer": {
            "type": "boolean"
          },
          "additional_property": {
            "type": "boolean"
          },
          "non_residential": {
            "type": "boolean"
          },
          "non_uk_resident": {
            "type": "boolean"
          }
        },
        "required": [
          "purchase_price"
        ]
      }
    },
    {
      "name": "draft_section_notice",
      "description": "Generate a Section 21 or Section 8 notice template.",
      "parameters": {
        "type": "object",
        "properties": {
          "notice_type": {
            "type": "string"
          },
          "landlord_name": {
            "type": "string"
          },
          "tenant_name": {
            "type": "string"
          },
          "property_address": {
            "type": "string"
          },
          "tenancy_start_date": {
            "type": "string"
          },
          "grounds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "arrears_amount": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "notice_type",
          "landlord_name",
          "tenant_name",
          "property_address",
          "tenancy_start_date"
        ]
      }
    },
    {
      "name": "check_right_of_way",
      "description": "Analyze a right of way or easement and explain its implications.",
      "parameters": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "right_type": {
            "type": "string",
            "nullable": true
          },
          "registered": {
            "type": "boolean"
          }
        },
        "required": [
          "description"
        ]
      }
    }
  ]
}
